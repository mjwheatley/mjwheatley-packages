{
  "name": "@mjwheatley/mjwheatley-packages",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "clean": "nx run-many -t clean --no-tui",
    "build": "nx run-many -t build --no-tui",
    "typecheck": "nx run-many -t typecheck --no-tui",
    "format": "prettier --write .",
    "format:check": "nx format:check --all",
    "lint": "nx run-many -t lint --no-tui",
    "prepare": "husky || true",
    "secretlint": "secretlint .  --maskSecrets",
    "spellcheck": "cspell --no-progress .",
    "test": "vitest --run",
    "test:all": "nx run-many -t test --nxBail --parallel=4 --silent=passed-only --no-tui",
    "test:coverage:combine": "pnpm dlx tsx packages/nx-vitest-config/src/combine-coverage-reports-cli.ts",
    "check:circular": "madge --circular --extensions ts,js,tsx .",
    "postinstall": "tsc --build packages/eslint-config/tsconfig.lib.json && pnpm build"
  },
  "devDependencies": {
    "@commitlint/config-nx-scopes": "^20.4.0",
    "@commitlint/types": "catalog:",
    "@eslint/js": "^9.39.3",
    "@mjwheatley/commitlint-config": "workspace:*",
    "@mjwheatley/cspell-dictionary": "workspace:*",
    "@mjwheatley/eslint-config": "workspace:*",
    "@mjwheatley/prettier-config": "workspace:*",
    "@mjwheatley/secretlint-config": "workspace:*",
    "@mjwheatley/semantic-release-config": "workspace:*",
    "@nx/eslint": "22.5.1",
    "@nx/eslint-plugin": "^22.5.1",
    "@nx/js": "22.5.1",
    "@nx/vite": "catalog:",
    "@nx/web": "22.5.1",
    "@nx/workspace": "22.5.1",
    "@secretlint/secretlint-rule-pattern": "^11.3.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.11",
    "@swc/helpers": "~0.5.18",
    "@types/node": "25.3.0",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "^4.0.18",
    "commitlint": "catalog:",
    "cspell": "^9.6.4",
    "esbuild": "^0.27.3",
    "eslint": "~9.39.3",
    "eslint-plugin-import-x": "^4.12.2",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "nx": "22.5.1",
    "prettier": "^3.8.1",
    "secretlint": "^11.3.1",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "verdaccio": "^6.2.5",
    "vite": "^7.3.1",
    "vitest": "catalog:",
    "vitest-sonar-reporter": "catalog:",
    "yargs": "^18.0.0"
  },
  "packageManager": "pnpm@10.30.1",
  "nx": {
    "includedScripts": []
  }
}
