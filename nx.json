{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.test.json",
      "!{projectRoot}/eslint.config.js",
      "!{projectRoot}/eslint.config.mjs"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.github/workflows/pull-request.yml",
      "{workspaceRoot}/.github/workflows/release.yml"
    ]
  },
  "targetDefaults": {
    "@nx/vite:test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "{workspaceRoot}/coverage/{projectRoot}"
      }
    },
    "build": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "configFile": "{projectRoot}/vitest.config.mts"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "rm -rf ./dist ./*.tsbuildinfo"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "{projectRoot}"
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ],
  "release": {
    "projects": ["packages/*"],
    "releaseTagPattern": "{projectName}/v{version}",
    "projectsRelationship": "independent",
    "conventionalCommits": {
      "types": {
        "build": {
          "semverBump": "none",
          "changelog": {
            "title": "Build System"
          }
        },
        "ci": {
          "semverBump": "none",
          "changelog": {
            "title": "Continuous Integration"
          }
        },
        "chore": {
          "semverBump": "none",
          "changelog": {
            "title": "Miscellaneous Chores"
          }
        },
        "docs": {
          "semverBump": "patch",
          "changelog": {
            "title": "Documentation Updates"
          }
        },
        "feat": {
          "semverBump": "minor",
          "changelog": {
            "title": "New Features"
          }
        },
        "fix": {
          "semverBump": "patch",
          "changelog": {
            "title": "Bug Fixes"
          }
        },
        "perf": {
          "semverBump": "patch",
          "changelog": {
            "title": "Performance Improvements"
          }
        },
        "refactor": {
          "semverBump": "patch",
          "changelog": {
            "title": "Code Refactoring"
          }
        },
        "revert": {
          "semverBump": "none",
          "changelog": {
            "title": "Reverts"
          }
        },
        "style": {
          "semverBump": "none",
          "changelog": {
            "title": "Code Style Changes"
          }
        },
        "test": {
          "semverBump": "none",
          "changelog": {
            "title": "Tests"
          }
        }
      }
    },
    "version": {
      "preVersionCommand": "pnpm dlx nx run-many -t build",
      "conventionalCommits": true,
      "updateDependents": "never",
      "fallbackCurrentVersionResolver": "disk"
    },
    "changelog": {
      "automaticFromRef": true,
      "git": {
        "commit": false
      },
      "projectChangelogs": {
        "file": false,
        "createRelease": "github"
      }
    }
  }
}
