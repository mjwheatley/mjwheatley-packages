{
  "name": "package-one",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/package-one/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/package-one/dist",
        "main": "packages/package-one/src/index.ts",
        "tsConfig": "packages/package-one/tsconfig.lib.json",
        "assets": ["packages/package-one/*.md"],
        "format": ["cjs", "esm"]
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "npx semantic-release-plus --extends ./packages/commitlint-config/release.config.js",
        "parallel": false
      }
    }
  }
}
