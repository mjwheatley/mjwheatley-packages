{
  "patterns": [
    {
      "name": "TicketNumber",
      "pattern": "(?<=^|\\s)\\[?(?<ticketNumber>[A-Z]{3,}-\\d+(-\\d+)?)\\]?(?=[\\s.]|$)"
    },
    {
      "name": "HtmlEntities",
      "pattern": "&([a-zA-Z0-9]+|#\\d+);"
    },
    {
      "name": "CVE",
      "pattern": "CVE-\\d{4}-\\d+"
    },
    {
      "name": "GHSA",
      "pattern": "GHSA-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}"
    }
  ],
  "ignoreRegExpList": ["TicketNumber", "HtmlEntities", "CVE", "GHSA"],
  "dictionaries": [
    "acronyms",
    "common filenames",
    "identifiers",
    "packages",
