{
  "version": "0.2",
  "import": ["@mjwheatley/cspell-dictionary"],
  "words": ["minimatch", "startover"],
  "ignorePaths": [
    ".vscode/",
    "node_modules",
    "dist",
    "build",
    "coverage",
    "private",
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "*.tsbuildinfo"
  ],
  "languageSettings": [
    {
      "languageId": "commit-msg",
      "ignoreRegExpList": ["/^#.*/gm"]
    }
  ]
}
